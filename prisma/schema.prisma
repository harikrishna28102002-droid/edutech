datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  name            String
  role            Role             @default(STUDENT)
  avatarUrl       String?
  bio             String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  coursesCreated  Course[]         @relation("InstructorCourses")
  enrollments     Enrollment[]
  progressRecords LessonProgress[]
  reviews         Review[]

  @@map("users")
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  courses     Course[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("categories")
}

model Course {
  id           String       @id @default(cuid())
  title        String
  slug         String       @unique
  subtitle     String?
  description  String       @db.Text
  level        CourseLevel  @default(BEGINNER)
  price        Decimal      @default(0.00) @db.Decimal(10, 2)
  thumbnailUrl String?
  isPublished  Boolean      @default(false)

  instructorId String
  instructor   User         @relation("InstructorCourses", fields: [instructorId], references: [id], onDelete: Cascade)

  categoryId   String?
  category     Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  modules      Module[]
  enrollments  Enrollment[]
  reviews      Review[]

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("courses")
}

model Module {
  id          String   @id @default(cuid())
  title       String
  description String?
  orderIndex  Int
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([courseId, orderIndex])
  @@map("modules")
}

model Lesson {
  id              String           @id @default(cuid())
  title           String
  slug            String
  content         String?          @db.Text
  videoUrl        String?
  durationMinutes Int              @default(10)
  orderIndex      Int
  isFreePreview   Boolean          @default(false)

  moduleId        String
  module          Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  progressRecords LessonProgress[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([moduleId, orderIndex])
  @@map("lessons")
}

model Enrollment {
  id              String           @id @default(cuid())
  userId          String
  courseId        String
  status          EnrollmentStatus @default(ACTIVE)
  progressPercent Float            @default(0.0)
  completedAt     DateTime?

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course          Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([userId, courseId])
  @@map("enrollments")
}

model LessonProgress {
  id                  String    @id @default(cuid())
  userId              String
  lessonId            String
  isCompleted         Boolean   @default(false)
  completedAt         DateTime?
  lastPositionSeconds Int       @default(0)

  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson              Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([userId, lessonId])
  @@map("lesson_progress")
}

model Review {
  id        String   @id @default(cuid())
  rating    Int      @default(5)
  comment   String?  @db.Text
  userId    String
  courseId  String

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
  @@map("reviews")
}

model DocSource {
  id            String    @id @default(cuid())
  name          String    @unique
  repo          String
  branch        String    @default("master")
  docsPath      String    @default("docs/en/docs")
  lastCommitSha String?
  lastSyncAt    DateTime?
  syncStatus    String    @default("IDLE") // IDLE, SYNCING, SUCCESS, ERROR
  syncError     String?   @db.Text
  pagesCount    Int       @default(0)

  pages         DocPage[]
  syncLogs      SyncLog[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("doc_sources")
}

model DocPage {
  id          String    @id @default(cuid())
  sourceId    String
  source      DocSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  title       String
  slug        String
  category    String    @default("general")
  path        String
  githubUrl   String
  content     String    @db.Text
  excerpt     String?   @db.Text
  contentSha  String
  orderIndex  Int        @default(0)

  chunks      DocChunk[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([sourceId, path])
  @@index([sourceId, category])
  @@index([slug])
  @@map("doc_pages")
}

model DocChunk {
  id          String    @id @default(cuid())
  pageId      String
  page        DocPage   @relation(fields: [pageId], references: [id], onDelete: Cascade)

  chunkIndex  Int
  heading     String?
  headingPath String?
  content     String    @db.Text
  tokenCount  Int       @default(0)
  embedding   Float[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([pageId])
  @@index([chunkIndex])
  @@map("doc_chunks")
}

model SyncLog {
  id             String    @id @default(cuid())
  sourceId       String
  source         DocSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  status         String    // SUCCESS, FAILED, IN_PROGRESS
  addedCount     Int       @default(0)
  updatedCount   Int       @default(0)
  unchangedCount Int       @default(0)
  totalCount     Int       @default(0)
  commitSha      String?
  message        String?   @db.Text
  durationMs     Int       @default(0)

  createdAt      DateTime  @default(now())

  @@index([sourceId, createdAt])
  @@map("sync_logs")
}

model EvalBenchmark {
  id          String         @id @default(cuid())
  name        String         @unique
  description String?
  sourceRepo  String         @default("tiangolo/fastapi")
  totalCases  Int            @default(0)
  testCases   EvalTestCase[]
  runs        EvalRun[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("eval_benchmarks")
}

model EvalTestCase {
  id               String        @id @default(cuid())
  benchmarkId      String
  benchmark        EvalBenchmark @relation(fields: [benchmarkId], references: [id], onDelete: Cascade)

  discussionNumber Int?
  discussionUrl    String?
  category         String
  question         String        @db.Text
  referenceAnswer  String        @db.Text
  targetDocPath    String?
  verificationCode String?       @db.Text
  tags             String[]

  results          EvalResult[]

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([benchmarkId, category])
  @@map("eval_test_cases")
}

model EvalRun {
  id               String        @id @default(cuid())
  benchmarkId      String
  benchmark        EvalBenchmark @relation(fields: [benchmarkId], references: [id], onDelete: Cascade)

  status           String        @default("RUNNING") // RUNNING, COMPLETED, FAILED
  modelProvider    String        @default("local")
  totalTests       Int           @default(0)
  passedTests      Int           @default(0)
  codePassRate     Float         @default(0.0)
  retrievalHitRate Float         @default(0.0)
  avgLatencyMs     Int           @default(0)

  results          EvalResult[]

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([benchmarkId, createdAt])
  @@map("eval_runs")
}

model EvalResult {
  id              String       @id @default(cuid())
  runId           String
  run             EvalRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  testCaseId      String
  testCase        EvalTestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  generatedAnswer String       @db.Text
  retrievedSources Json
  retrievalHit    Boolean      @default(false)
  codeExecuted    Boolean      @default(false)
  codePassed      Boolean      @default(false)
  sandboxStdout   String?      @db.Text
  sandboxStderr   String?      @db.Text
  latencyMs       Int          @default(0)
  score           Float        @default(0.0)

  createdAt       DateTime     @default(now())

  @@index([runId])
  @@index([testCaseId])
  @@map("eval_results")
}

// -------------------------------------------------------------
// Training Data Engine Models (Real Doc Chunk Instruction Tuning)
// -------------------------------------------------------------

model TrainingDataset {
  id              String           @id @default(cuid())
  name            String           @unique
  description     String?          @db.Text
  format          String           @default("ALPACA") // ALPACA, CHATML, DPO, RETRIEVAL_TRIPLET
  version         String           @default("1.0.0")
  totalSamples    Int              @default(0)
  trainCount      Int              @default(0)
  valCount        Int              @default(0)
  testCount       Int              @default(0)
  sourceRepo      String           @default("fastapi/fastapi")

  samples         TrainingSample[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("training_datasets")
}

model TrainingSample {
  id               String          @id @default(cuid())
  datasetId        String
  dataset          TrainingDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  split            String          @default("TRAIN") // TRAIN, VALIDATION, TEST
  format           String          @default("ALPACA")

  // Instruction tuning & Chat fields
  instruction      String          @db.Text
  inputContext     String?         @db.Text
  outputResponse   String          @db.Text

  // DPO preference fields (chosen vs rejected)
  rejectedResponse String?         @db.Text

  // Retrieval Triplet fields (hard negatives)
  negativeContext  String?         @db.Text

  // Provenance / source tracking
  sourceDocPath    String?
  sourceChunkIndex Int?
  category         String          @default("general")
  tags             String[]

  createdAt        DateTime        @default(now())

  @@index([datasetId, split])
  @@index([category])
  @@map("training_samples")
}

